+# 纯文生图时空 latent 默认是 resolution 的正方形；提示词里写了明确的长宽比
+# （如 "9:16"、"2:3"）时按比例拆分，resolution 只当长边用。要求两数都不超过 32、
+# 比例不比 8:1 更极端（避免把 "10:30" 这类时间当成 1:3）。
+_PROMPT_RATIO_RE = re.compile(r"(?<![\d.])(\d{1,2})\s*[:：]\s*(\d{1,2})(?![\d.])")
+
+
+def _prompt_ratio_size(prompt, resolution):
+    for m in _PROMPT_RATIO_RE.finditer(prompt or ""):
+        a, b = int(m.group(1)), int(m.group(2))
+        if a == b or max(a, b) > 32 or min(a, b) * 8 < max(a, b):
+            continue
+        long_side = resolution or 1024
+        short_side = max(16, round(long_side * min(a, b) / max(a, b) / 16) * 16)
+        size = (long_side, short_side) if a > b else (short_side, long_side)
+        logging.getLogger(__name__).info("Prompt aspect ratio %d:%d -> %dx%d", a, b, size[0], size[1])
+        return size
+    return resolution or 1024, resolution or 1024
+
