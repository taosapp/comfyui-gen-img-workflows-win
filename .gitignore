# 本仓库只跟踪策划资产：工作流 / 风格库 / 自建节点 / 补丁 / 文档。
# 目录本体同时是一套完整 ComfyUI 运行环境（上游代码 + 模型 + 个人素材），
# 一律不进 git，采用白名单模式：

/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/workflows/
!/styles/
!/custom_nodes/
!/patches/
!/scripts/
!/docs/

# 启动器（.bat 是 GBK 编码，靠 .gitattributes 防止换行符被改写）
# 其 UTF-8 源与重建/自检脚本在 scripts/launcher/ 下，随 scripts/ 一起跟踪
!/start_comfyui.bat
!/start_comfyui_mac.sh
!/make_style.bat

# custom_nodes 里只保留自建节点包
/custom_nodes/*
!/custom_nodes/comfyui-style-prompt/

# 启动器首次重建时留下的旧 .bat 备份（本机保险，不进仓库）
/scripts/launcher/backup/

# Python
__pycache__/
*.pyc
.venv/

# 系统文件
Thumbs.db
.DS_Store
